# DeepSeek API key - get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxx

# Optional: override model (default: deepseek-chat)
# Options: deepseek-chat (V3, faster) | deepseek-reasoner (R1, deeper thinking)
# DEEPSEEK_MODEL=deepseek-chat

# Optional: enable web search via Tavily (free 1000/month at https://tavily.com/)
# TAVILY_API_KEY=tvly-xxx
